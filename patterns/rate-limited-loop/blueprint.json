{
  "name": "Rate-limited loop",
  "description": "Iterates over an array of items and calls an external API once per item, pausing between calls with util:FunctionSleep to respect the API's rate limit. Sleep accepts 1–300 seconds; for large volumes prefer splitting work across scheduled runs instead of long sleeps.",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{1.items}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "util:FunctionSleep",
      "version": 1,
      "parameters": {},
      "mapper": {
        "duration": 1
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "https://api.example.com/items/{{2.id}}",
        "method": "put",
        "headers": [],
        "contentType": "json",
        "parseResponse": true,
        "queryParameters": [],
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\"email\": \"{{2.email}}\"}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}
